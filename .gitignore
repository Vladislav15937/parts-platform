target/
node_modules/
frontend/dist/
# Кэш предсборки Vite: содержимое зависит от версии node и от машины.
frontend/.vite/
.idea/
*.iml
.vscode/
.DS_Store
*.log
# Журнал расписания ячейки и его прокрученные копии (ops/rotate-log.sh).
# Каталог ячейки — это рабочая копия репозитория, и `*.log` выше не покрывает
# ни `parts-backup.log.1`, ни `parts-backup.log.2.gz`: прокрученные копии
# показывались бы в `git status` на боевой машине как мусор, в котором
# при выкладке надо разбираться.
logs/

# Секреты развёртывания
.env

# Наборы бэкапов
backups/

# Токен бота тревог: секрет, а не конфигурация.
ops/secrets/

# Постоянные ссылки на прайсы стенда: в них зашит токен выгрузки, то есть
# это секрет. Кладёт файл кнопка раскатки (.github/workflows/deploy.yml),
# читает ops/deploy-checks.sh. Журнал выкладок стенда (deploy-history.log)
# под «*.log» выше — он состояние машины, а не репозитория.
.deploy-feeds
# Вход дымового прогона стенда (компания, логин, пароль продавца) — секрет
# по той же причине. Кладёт кнопка, читает ops/smoke-run.sh.
.deploy-smoke
.claude/worktrees/

# Одно место на все подделки доказательства: копии скриптов со снятой проверкой,
# стабы, `if false`. Ломать код здесь — договор, а не нарушение (`reviewer.md`
# велит вернуть прежнее поведение и прогнать), поэтому такие файлы появляются
# каждую волну, — а до задачи 0248 у них не было ни места, ни этой строки,
# и `git add -A` увозил их в ветку как работу. Подделка опаснее обычной чужой
# правки: она не меняет поведение, а СНИМАЕТ проверку, то есть уезжает зелёной
# и оставляет сторожа, который не краснеет на дефекте.
#
# Почему каталог корневой, а не внутри `ops/`: копия скрипта считает корень
# репозитория от своего каталога (`cd "$(dirname "$0")/.."`), поэтому из `/tmp`
# она уходит в корень файловой системы (урок 0151), а отсюда попадает туда же,
# куда из `ops/`, `tools/` и `db/`. Правило 0151 выполнено, и при этом каталог
# игнорируется — чего про `ops/` сказать нельзя.
#
# Правило целиком — `docs/agent-workflow.md`, «Подделки доказательства живут
# в одном месте»; сторож — `tools/fake-guard.py`.
.scratch/
