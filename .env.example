# Развёртывание ячейки. Скопируйте в .env и заполните.
# .env в репозиторий не коммитится — см. .gitignore.

# --- База ---
DB_USER=partsflow
DB_PASSWORD=

# --- Ключ шифрования секретов площадок ---
# Сгенерировать: openssl rand -base64 32
#
# Потеряете — ключи кабинетов Дрома не расшифруются, и запрашивать их придётся
# заново. Копию держите отдельно от бэкапа базы: вместе они дают ровно то же,
# что и хранение открытым текстом.
APP_CRYPTO_KEY=

# --- Секрет создания арендаторов ---
# Пустой выключает механизм, и это верное значение по умолчанию: забытый
# включённым, он даёт любому желающему заводить схемы, пока не кончится диск.
# Задавайте на время подключения клиента и убирайте после.
APP_PROVISIONING_TOKEN=

# --- Домены ---
# Оба должны указывать A-записью на эту машину ДО первого запуска: Caddy
# получает сертификат сам, а Let's Encrypt проверяет владение доменом
# запросом на него же.
APP_DOMAIN=parts.example.ru
S3_DOMAIN=s3.example.ru

# Куда Let's Encrypt напишет о проблеме с продлением. Без верного адреса
# узнать о ней будет неоткуда — сертификат просто перестанет работать,
# и в тот же день у приёмщиков пропадёт камера.
ACME_EMAIL=

# --- Внешние адреса ---
# Домен, по которому открывают приложение. Он же уходит в CORS хранилища.
PUBLIC_ORIGIN=https://parts.example.ru

# Внешний адрес хранилища фотографий. Хост входит в подпись ссылки:
# подписанная внутренним именем, она с телефона не откроется.
S3_PUBLIC_ENDPOINT=https://s3.example.ru

S3_ACCESS_KEY=partsflow
S3_SECRET_KEY=

# --- Управляющий контур ---
# Откуда разрешено обращаться к /api/provisioning: создание арендаторов
# и накат миграций на все схемы ячейки. Аутентификации у него нет
# по устройству — только секрет, — поэтому сеть ограничивается отдельно.
# Несколько диапазонов пишутся через пробел.
#
# Умолчание — петля: управлять ячейкой только с самой машины,
# через docker compose exec.
PROVISIONING_ALLOW=127.0.0.1/32

# --- Наблюдение -------------------------------------------------------------
# Куда приходит тревога. Бот заводится у @BotFather, номер чата даёт
# @userinfobot; для группы номер отрицательный.
#
# Пустые значения валят запуск намеренно: тревога, уходящая в никуда, хуже
# отсутствия тревог — она создаёт уверенность, что за ячейкой смотрят.
ALERT_TELEGRAM_CHAT_ID=
# Путь к файлу с токеном бота. Файлом, а не переменной: в переменной токен
# виден в `docker inspect` любому, кто дошёл до хоста. Права — 600.
ALERT_TELEGRAM_TOKEN_FILE=./ops/secrets/telegram-token

# --- Ячейка -----------------------------------------------------------------
# Имя ячейки: имя проекта compose (а значит, и томов), префикс топиков Kafka,
# метка на тревогах и каталог бэкапов. У двух ячеек оно обязано различаться —
# одинаковое означает общие тома, то есть общую базу.
APP_CELL=cell01
# Номер ячейки — старший разряд номера арендатора: у второй клиенты начинаются
# с 2 000 001. Без этого схема t_000001 есть в обеих, и дамп из одной нельзя
# развернуть в другую без переименования. У работающей ячейки не менять:
# заведённые номера не двинутся, а новые уедут в чужой диапазон.
APP_CELL_NUMBER=1
# Порт отметок бэкапа на петле. Менять надо только если на машине больше
# одной ячейки — в бою это не так.
PUSHGATEWAY_PORT=9091
PUSHGATEWAY_URL=http://localhost:9091

# Офсайт-копия бэкапа: путь rclone на другой хост или в другой бакет.
# Дампы и зеркало снимков лежат на той же машине, что и ячейка, — потеря
# диска уносит клиента вместе с его бэкапом. Этот адрес увозит копию наружу.
# Формат — как у rclone: «имя-удалёнки:путь» (S3, B2, SFTP). Настроить саму
# удалёнку — rclone config, ключи храните рядом с прочими секретами ячейки.
# Пусто — офсайта нет, и ops/backup.sh громко об этом предупреждает: пилот
# на одной машине так и работает, но до первого чужого клиента адрес задать.
OFFSITE_REMOTE=

# Разделение ролей базы (ops/create-roles.sh, шаг 3 развёртывания).
# Приложение работает рабочей ролью и журналами не владеет: переписать
# движение склада или запись аудита прямым SQL из него нельзя. Схемы создаёт
# и мигрирует владелец. Пустые значения означают одну роль на всё — так можно
# в разработке, и приложение скажет об этом предупреждением при старте.
#
# Заполняет их шаг 3, и заполняет все разом: имя рабочей роли без её пароля
# означает подключение ролью, которой в свежей базе ещё нет, — приложение
# не поднимается вовсе, отвечая «password authentication failed». Владелец
# схем (APP_DDL_USERNAME) — это DB_USER, его заводит сам Postgres.
APP_RUNTIME_ROLE=
APP_RUNTIME_PASSWORD=
APP_DDL_URL=jdbc:postgresql://postgres:5432/parts
APP_DDL_USERNAME=
APP_DDL_PASSWORD=
