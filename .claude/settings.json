{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "WebSearch",
      "WebFetch(domain:baza.drom.ru)",
      "WebFetch(domain:farpost.ru)",
      "WebFetch(domain:infostart.ru)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "tools/test-output-filter.sh"
          }
        ]
      }
    ]
  }
}
