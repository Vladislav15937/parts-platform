<?xml version="1.0" encoding="UTF-8"?>
<!--
    Схема одного арендатора. Накатывается при провижининге и при каждой миграции.
    Команда запуска — в README и в verify.sh.

    Параметр liquibaseSchemaName критичен: DATABASECHANGELOG должен лежать ВНУТРИ
    схемы арендатора. Это даёт два свойства: каждый арендатор версионируется
    независимо, а дамп одной схемы забирает и данные, и историю миграций одним
    куском. Побочно решается и блокировка: DATABASECHANGELOGLOCK тоже свой,
    поэтому миграции разных арендаторов идут параллельно без взаимных ожиданий.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd">

    <!-- Значение по умолчанию для локальной отладки; в проде передаётся -D -->
    <property name="tenant.schema" value="t_000001" global="false"/>

    <include file="tenant/001-schema-and-functions.sql" relativeToChangelogFile="true"/>
    <include file="tenant/002-organization.sql"         relativeToChangelogFile="true"/>
    <include file="tenant/003-donors.sql"               relativeToChangelogFile="true"/>
    <include file="tenant/004-parts.sql"                relativeToChangelogFile="true"/>
    <include file="tenant/005-inventory.sql"            relativeToChangelogFile="true"/>
    <include file="tenant/006-sales.sql"                relativeToChangelogFile="true"/>
    <include file="tenant/007-publishing.sql"           relativeToChangelogFile="true"/>
    <include file="tenant/008-platform.sql"             relativeToChangelogFile="true"/>
    <include file="tenant/010-supply-and-warehouses.sql" relativeToChangelogFile="true"/>
    <include file="tenant/011-sales.sql"                relativeToChangelogFile="true"/>
    <include file="tenant/012-stock-reservation.sql"    relativeToChangelogFile="true"/>
    <include file="tenant/013-part-status.sql"          relativeToChangelogFile="true"/>
    <include file="tenant/014-part-category-optional.sql" relativeToChangelogFile="true"/>
    <include file="tenant/015-member-credentials.sql"    relativeToChangelogFile="true"/>
    <include file="tenant/016-client-request-id.sql"     relativeToChangelogFile="true"/>
    <include file="tenant/017-event-consumers.sql"       relativeToChangelogFile="true"/>
    <include file="tenant/018-feed-token.sql"            relativeToChangelogFile="true"/>
    <include file="tenant/019-publish-by-default.sql"    relativeToChangelogFile="true"/>
    <include file="tenant/020-import-run.sql"            relativeToChangelogFile="true"/>
    <include file="tenant/021-dead-letter-retry.sql"     relativeToChangelogFile="true"/>
    <include file="tenant/022-donor-legacy-code.sql"     relativeToChangelogFile="true"/>
    <include file="tenant/023-donor-brand-nullable.sql"  relativeToChangelogFile="true"/>
    <include file="tenant/024-marketplace-orders.sql"    relativeToChangelogFile="true"/>
    <include file="tenant/025-deal-services.sql"        relativeToChangelogFile="true"/>
    <include file="tenant/026-sales-by-source.sql"      relativeToChangelogFile="true"/>
    <include file="tenant/027-feed-filters.sql"        relativeToChangelogFile="true"/>
    <include file="tenant/028-deal-version.sql"        relativeToChangelogFile="true"/>
    <include file="tenant/029-feed-lists.sql"          relativeToChangelogFile="true"/>
    <include file="tenant/030-deal-share.sql"          relativeToChangelogFile="true"/>
    <include file="tenant/031-wheels.sql"              relativeToChangelogFile="true"/>
    <include file="tenant/032-donor-body-engine.sql"   relativeToChangelogFile="true"/>

    <!-- Вьюхи идут последними: они читают колонки, добавленные в 010. -->
    <include file="tenant/009-views.sql"                relativeToChangelogFile="true"/>

</databaseChangeLog>
