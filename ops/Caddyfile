# Терминатор ячейки: сертификаты, шифрование, доступ к управляющему контуру.
#
# Caddy, а не nginx с certbot: сертификаты он получает и продлевает сам,
# без крона и без забытого продления, о котором узнают в день, когда
# у приёмщиков перестаёт открываться приложение.
#
# Локальная проверка: APP_DOMAIN=localhost — Caddy выпустит сертификат
# собственным центром, ACME не участвует.
{
	# Адрес для писем Let's Encrypt об истечении. Умолчание нужно только
	# чтобы конфигурация разбиралась при локальной проверке: для настоящего
	# домена задавайте свой, иначе о проблеме с продлением узнать неоткуда.
	email {$ACME_EMAIL:noreply@localhost}
}

{$APP_DOMAIN} {
	encode zstd gzip

	header {
		# Год HSTS. Без preload намеренно: попадание в списки браузеров
		# необратимо, а домен клиента может понадобиться под что-то ещё.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# Приложение никто не встраивает во фрейм, а кликджекинг по кнопке
		# «Выдать» стоит выданного товара.
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		-Server
	}

	# Управляющий контур: создание арендаторов и накат миграций на все схемы
	# ячейки. Аутентификации у него нет по устройству — только секрет,
	# — поэтому сеть ограничивается здесь, а не одним ключом.
	#
	# Разрешение и отказ — двумя сопоставителями на уровне сайта, а не
	# вложенным условием: так порядок виден в конфигурации, а не выводится
	# из вложенности.
	#
	# Диапазон задавайте по тому адресу, который видит сам терминатор.
	# Он не обязан быть тем, что вы ожидаете: за NAT провайдера, за docker
	# или за чужим балансировщиком это будет их адрес, а не ваш. Проверять
	# так: `docker compose -f docker-compose.prod.yml logs caddy` после
	# заведомо отбитого запроса.
	@provisioning path /api/provisioning*
	@provisioningAllowed {
		path /api/provisioning*
		remote_ip {$PROVISIONING_ALLOW:127.0.0.1/32}
	}

	# Порядок значим: сначала разрешённые, потом отказ всем остальным
	# на этом пути, и только затем общий проход.
	handle @provisioningAllowed {
		reverse_proxy app:8080
	}

	handle @provisioning {
		# 404, а не 403: чужому незачем знать, что управляющий контур
		# вообще существует по этому адресу.
		respond 404
	}

	# Метрики и прочий actuator наружу не смотрят. Сборщик метрик живёт
	# внутри сети docker и ходит в app:8080 напрямую, минуя терминатор;
	# снаружи этот адрес рассказывал бы об устройстве системы и о нагрузке
	# всякому желающему. Проверки живости тоже отсюда не видны — они нужны
	# docker, а он спрашивает контейнер, а не домен.
	handle /actuator* {
		# 404, а не 403: по той же причине, что и управляющий контур.
		respond 404
	}

	handle {
		reverse_proxy app:8080
	}
}

# Хранилище фотографий отдельным именем: телефон грузит снимок туда напрямую
# по подписанной ссылке, мимо приложения.
{$S3_DOMAIN} {
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	# Host не подменяем. Он входит в подпись ссылки, и переписанный заголовок
	# превратил бы каждую загрузку фотографии в «SignatureDoesNotMatch».
	# Caddy сохраняет исходный Host сам — эта строка лишь напоминает,
	# что добавлять сюда header_up Host нельзя.
	reverse_proxy minio:9000
}
