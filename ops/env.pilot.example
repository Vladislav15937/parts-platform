# Пилот на Timeweb (сервер 200.165.228.163, домен plus-parts.ru).
# Скопировать на сервере в .env и заполнить пустые значения.
#
#   cp ops/env.pilot.example .env
#
# Порядок заполнения:
#   1. APP_IMAGE_TAG — полный SHA выкладываемого коммита (`git rev-parse HEAD`).
#   2. Секреты — выполнить команды `openssl rand` (в комментариях) прямо
#      на сервере и вставить вывод. НЕ придумывать руками, не переиспользовать.
#   3. Telegram — токен бота положить в файл, номер чата вписать.
#   4. rclone — OFFSITE_REMOTE, после `rclone config`.
#   5. ACME_EMAIL — свою почту.
#   6. Секцию ролей заполнит ops/create-roles.sh (шаг 3 деплоя) — вставить,
#      что напечатает.
#
# .env в репозиторий не коммитится (.gitignore). Этот шаблон — коммитится,
# поэтому в нём НЕТ ни одного реального секрета.

# --- Версия приложения ---
# SHA коммита, образ которого собрал и опубликовал CI. Ячейка ничего
# не собирает: `docker compose pull` забирает готовый образ из реестра,
# поэтому ни исходников, ни JDK с node на сервере не нужно.
#
# Откуда взять: `git rev-parse HEAD` в клоне на сервере (если прогон CI
# на этом коммите зелёный) либо последняя строка задачи «Публикация образа»
# в самом прогоне. Сорок символов, а не семь: короткого тега в реестре нет,
# и `pull` отвечает «manifest unknown».
#
# Пустое значение валит запуск намеренно — умолчание вроде latest означало бы
# «неизвестно что» в тот день, когда надо назвать работающую у клиента версию.
# Откат — прежний SHA: образ из реестра никуда не делся.
APP_IMAGE_TAG=

# Где лежит образ. Умолчание — GHCR этого репозитория; переопределяют, когда
# ячейка стоит в закрытом контуре и образ едет через зеркало.
#APP_IMAGE=ghcr.io/vladislav15937/parts-platform

# --- Какие сборки поднимать ---
# Сборок две, синяя и зелёная: при выкладке новая поднимается рядом со старой
# и получает трафик только после проверки готовности (ops/switch-build.sh).
# Здесь перечислено, какие из них должны РАБОТАТЬ: в покое одна, на время
# выкладки обе («blue,green»). Строка не обязательна: без неё и с пустым
# значением поднимается прежняя сборка — синяя (задача 0110). Нужна она
# только чтобы переключаться.
COMPOSE_PROFILES=blue

# Тег образа выкладываемой сборки: задают на время выкладки, после успеха
# переносят в APP_IMAGE_TAG и убирают отсюда. Незаданное — «тот же, что
# у ячейки».
#APP_IMAGE_TAG_BLUE=
#APP_IMAGE_TAG_GREEN=

# --- База ---
DB_USER=partsflow
# openssl rand -base64 24
DB_PASSWORD=

# --- Ключ шифрования секретов площадок ---
# openssl rand -base64 32
# ПОТЕРЯ НЕОБРАТИМА: ключи кабинетов Дрома не расшифруются. Копию — ОТДЕЛЬНО
# от бэкапа базы (менеджер паролей, другой носитель). Вместе они = открытый текст.
APP_CRYPTO_KEY=

# --- Секрет создания арендаторов ---
# openssl rand -hex 24
# Задать на время подключения клиента, ПОСЛЕ — очистить (пустое = выключено)
# и пересоздать сборку под трафиком: `docker compose -f docker-compose.prod.yml
# up -d "$(ops/switch-build.sh --current)"`. Сервиса `app` в compose нет.
# Забытый включённым — любой заводит схемы, пока есть диск.
APP_PROVISIONING_TOKEN=

# --- Домены (уже указывают A-записью на 200.165.228.163) ---
APP_DOMAIN=parts.plus-parts.ru
S3_DOMAIN=s3.plus-parts.ru
PUBLIC_ORIGIN=https://parts.plus-parts.ru
S3_PUBLIC_ENDPOINT=https://s3.plus-parts.ru

# Куда Let's Encrypt напишет о проблеме с продлением сертификата. Своя почта.
ACME_EMAIL=

# --- Хранилище фотографий (внутренний MinIO ячейки) ---
S3_ACCESS_KEY=partsflow
# openssl rand -base64 24
S3_SECRET_KEY=

# --- Управляющий контур ---
# Откуда разрешено обращаться к /api/provisioning. Умолчание — только с самой
# машины (docker compose exec). Добавить свой рабочий IP можно через пробел,
# но безопаснее оставить петлю и заводить арендатора изнутри контейнера.
PROVISIONING_ALLOW=127.0.0.1/32

# --- Наблюдение ---
# Бот — @BotFather (токен). Номер чата — @userinfobot; для группы отрицательный.
# Пустое ALERT_TELEGRAM_CHAT_ID валит запуск намеренно: тревога в никуда хуже,
# чем её отсутствие.
ALERT_TELEGRAM_CHAT_ID=
# Токен бота — в этот файл (не в переменную: она видна в docker inspect).
# mkdir -p ops/secrets && echo -n '<токен>' > ops/secrets/telegram-token
# chmod 644 ops/secrets/telegram-token
# Именно 644, а не 600: контейнер Alertmanager бежит под nobody (uid 65534)
# и файл, доступный только владельцу, не прочитает — тревога сработает,
# но в Telegram не уйдёт (permission denied). На сервере с одним админом
# 644 ничего не ослабляет.
ALERT_TELEGRAM_TOKEN_FILE=./ops/secrets/telegram-token

# --- Ячейка ---
APP_CELL=cell01
APP_CELL_NUMBER=1
PUSHGATEWAY_PORT=9091
PUSHGATEWAY_URL=http://localhost:9091

# --- Точка возврата (архив WAL) ---
# Умолчания верны: архив ложится в ./backups/cell01/wal, две базовые копии,
# черновик возврата — в ./backups/pitr/cell01. Раскомментировать только если
# архив кладётся на другой диск (путь обязан совпасть с монтированием
# в postgres) или нужно окно возврата длиннее двух недель.
#WAL_ARCHIVE_DIR=./backups/cell01/wal
#BASEBACKUP_KEEP=2
#PITR_DIR=./backups/pitr/cell01

# --- Офсайт-копия бэкапа ---
# Путь rclone на другой хост/бакет (S3, B2, SFTP), формат «имя-удалёнки:путь».
# Завести: rclone config, проверить: rclone lsd <имя>:. Без него потеря диска
# уносит клиента вместе с локальным бэкапом, и тревога ОфсайтНеУезжал висит.
OFFSITE_REMOTE=

# --- Разделение ролей базы ---
# Заполняет ops/create-roles.sh (шаг 3): запусти его после первого `compose up`,
# он напечатает пять значений — вставь их сюда и пересоздай сборку под трафиком
# (`docker compose … up -d "$(ops/switch-build.sh --current)"`). Пустые = одна
# роль на всё (журналы правятся прямым SQL, приложение предупредит при старте).
# APP_DDL_USERNAME — это DB_USER (владелец схем), APP_DDL_PASSWORD — его пароль.
APP_RUNTIME_ROLE=
APP_RUNTIME_PASSWORD=
# Непустой APP_DDL_URL — только признак «владелец схем отдельный»: сам адрес
# compose строит на базу своей сборки (задача 0112). Имя базы здесь не читается.
APP_DDL_URL=jdbc:postgresql://postgres:5432/parts
APP_DDL_USERNAME=
APP_DDL_PASSWORD=

# --- База каждой сборки (задача 0112) ---
# Ведёт ops/deploy.sh: выкладка снимает копию базы работающей сборки, и новая
# сборка работает уже на копии. Руками не править — спрашивать
# ops/switch-build.sh --current-db. Незаданное — «parts», база, с которой
# ячейка родилась.
#APP_DB_BLUE=parts
#APP_DB_GREEN=parts
